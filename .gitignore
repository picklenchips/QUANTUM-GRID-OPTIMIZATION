# generally ignore irrelevant files in the github
# copied from Reddit

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# internal tracking that's unnecessary to commit
__pycache__
.vscode

# plotly / pandapower.plotting.plotly scratch output
temp-plot.html
*.plotly.html
nx.html

# dataset download caches (see data/*_to_pp.py / data/*_hook.py -- re-fetchable, not source)
# small offline test data lives in data/fixtures/ and IS committed
/.cache/
/data/gridsfm/
/data/opfdata/
/data/pglearn/
/data/gridfm/
/data/hifld/
/data/climrr/*.geojson
!data/fixtures/**

# secrets -- MAPBOX_TOKEN etc, see .env.example
.env